SKIP_PREFLIGHT_CHECK=true

PROTOCOL="https"
BACKEND_PORT=8383
FRONTEND_PORT=3003

FRONTEND_URL="@PROTOCOL://dashboard.progeo.com"
FULL_BACKEND_URL="@PROTOCOL://api.progeo.com"
BACKEND_URL="api.progeo.com"

LOGIN_TIME=3600

REDIS_PASSWORD="~~~~~~~~~~~~"
REDIS_HOST="progeo-redis"
REDIS_PORT=6379

DJANGO_DATABASES="main_db;unit_tests;dev_null"
POSTGRES_DB="default"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="progeo-database"
POSTGRES_PORT=5435
# Server tuning (docker-compose: progeo-database command). Unset = small-device
# defaults; on a big server e.g. 300 / 8GB / 8GB / 1gb (shm for parallel queries).
#POSTGRES_MAX_CONNECTIONS=300
#POSTGRES_SHARED_BUFFERS=8GB
#POSTGRES_MAX_WAL_SIZE=8GB
#POSTGRES_SHM_SIZE=1gb

# Per-project databases (python manage.py split_project_dbs / add_project_db)
PROJECT_DB_SPLIT=False
PROJECT_DB_STRICT=False
PROJECT_DB_PREFIX=""
# Own database of the public demo (python manage.py demo_account)
DEMO_DATABASE="demo"

DNS_FRONT_NAMES="dashboard.progeo.com localhost"
DNS_BACK_NAMES="api.progeo.com"

CERT_MODE="existing"
CERT_LOCAL="./docker/nginx/ssl"
CERT_PATH="/etc/nginx/ssl"
CERT_FILE="localhost-bundle.pem"
CERT_KEY="localhost-bundle.pem"
CERT_PASS=""

CONTROLLER_SSID="Progeo-Controller"
CONTROLLER_PASSWORD="~~~~~~~~~~~~"
# Target of the frontend QR code (GET /v1/<account>/setup/controller/qrcodes/)
CONTROLLER_FRONTEND_URL="http://192.168.161.1:3003"
CONTROLLER_COUNTRY_CODE="DE"
CONTROLLER_DEFAULT_ACCOUNT="default"
CONTROLLER_PROJECT_ID=1312
CONTROLLER_ROOT_LOCATION_ID=1

# uid/gid of the host user progeo and gid of the host's docker group;
# scripts/setup_system.sh fills them in (id -u / id -g progeo, getent group docker)
DOCKER_UID=
DOCKER_GID=
DOCKER_SOCKET_GID=

# Optional services, comma separated:
#   COMPOSE_PROFILES=cad_factory             -> build and run the cad factory
#   COMPOSE_PROFILES=monitoring              -> Prometheus, Grafana, Flower, exporters (see below)
#   COMPOSE_PROFILES=cad_factory,monitoring  -> both
#   COMPOSE_PROFILES=                        -> none of them (no build, no container)
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# Monitoring (compose profile "monitoring", docker/monitoring/README.md)
# ---------------------------------------------------------------------------
# Generate each secret with: openssl rand -hex 24
# Bearer token Prometheus scrapes the backend's /metrics with; empty = /metrics off
METRICS_TOKEN=
# Origin of the dashboard: nginx serves the UIs on <MONITORING_URL>/grafana/,
# /prometheus/ and /flower/ to Django superusers (log in on /aadmin/ first).
# Grafana and the links in alert mails use it.
MONITORING_URL="https://dashboard.progeo.com"
# Besides, the UIs (Grafana 3000, Prometheus 9090, Flower 5555) listen on this
# address only - keep 127.0.0.1 and use an SSH tunnel: ssh -L 3000:127.0.0.1:3000 <server>
MONITORING_BIND=127.0.0.1
#GRAFANA_UI_PORT=3000
#PROMETHEUS_UI_PORT=9090
#FLOWER_UI_PORT=5555
# Grafana login; the password applies on Grafana's first start only (then change it in the UI)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD="~~~~~~~~"
# Flower login (UI and Prometheus scrape)
FLOWER_USER=flower
FLOWER_PASSWORD="~~~~~~~~"
# Only if REDIS_PASSWORD has characters that are not URL-safe: the broker URL
# with the percent-encoded password, e.g. redis://:p%40ss@progeo-redis:6379/0
#FLOWER_BROKER_URL=
# Read-only database role (pg_monitor) of the postgres exporter, created by
# scripts/setup_monitoring_db_user.sh; password: A-Z a-z 0-9 . _ ~ - only
POSTGRES_MONITOR_USER=progeo_monitor
POSTGRES_MONITOR_PASSWORD=
# Alert mails (Alertmanager). Empty ALERT_EMAIL = alerts only show in Grafana/Prometheus.
ALERT_EMAIL=
# Shown in the mail subject: [progeo <name>] FIRING ...
ALERT_SERVER_NAME=
ALERT_SMTP_HOST="smtp.progeo.com:587"
ALERT_SMTP_FROM="no-reply@progeo.com"
ALERT_SMTP_USER="no-reply@progeo.com"
ALERT_SMTP_PASSWORD="~~~~~~~~"
# Prometheus keeps data this long, but never more than this size
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=5GB
# Own docker network of the monitoring services; the node exporter listens on
# its gateway. Change only if the subnet collides with an existing network.
#MONITORING_SUBNET=172.31.250.0/24
#MONITORING_GATEWAY=172.31.250.1
# Fixed address of progeo-nginx in that subnet - the only one Grafana accepts
# the auth proxy login from. Must lie inside MONITORING_SUBNET.
#MONITORING_NGINX_IP=172.31.250.250

# Periodic celery tasks (progeo/celery.py) that celery beat must not start, comma
# separated: "all", schedule names or task names, e.g.
#   CELERY_DISABLED_TASKS=all                                         -> none run
#   CELERY_DISABLED_TASKS=evaluate_measurements,check_existing_alarms -> only these off
# Use "all" while split_project_dbs runs; empty = everything runs.
CELERY_DISABLED_TASKS=
# Cron jobs of the backend container that must not run (applied at container
# start), comma separated: half-hour, measure (scan_devices), daily (dbbackup of
# every database), weekly - or "all". Empty = everything runs.
CRON_DISABLED_JOBS=

# ---------------------------------------------------------------------------
# Backup transfer: after the nightly dumps (cron job "daily", 23:53) the newest
# dump of every database goes as ONE tar file to this server over SFTP:
#   <BACKUP_REMOTE_PATH>/progeo-<YYYY-MM-DD-HHMMSS>.tar (+ .sha256)
# Empty BACKUP_REMOTE_HOST = off. Setup and restore: README.md, "Backups"
# ---------------------------------------------------------------------------
BACKUP_REMOTE_HOST=
#BACKUP_REMOTE_PORT=22
BACKUP_REMOTE_USER=
# The server's host key - only this one is accepted. One line of:
#   ssh-keyscan -p 22 -t ed25519 <host>
BACKUP_REMOTE_HOST_KEY=""
# Login with the key ./secrets/backup/id_ed25519 (mounted to /etc/progeo/backup);
# the password is only used while that file is missing.
#BACKUP_REMOTE_KEY_FILE=/etc/progeo/backup/id_ed25519
BACKUP_REMOTE_PASSWORD=
# Directory on the server (relative = below the login directory), created if missing
BACKUP_REMOTE_PATH=progeo-backups
# Bundles kept on the server, older ones are deleted (0 = keep all)
BACKUP_REMOTE_KEEP=14

# Error tracking (sentry-sdk -> GlitchTip, see progeo/sentry.py). Empty SENTRY_DSN = disabled,
# leave it empty on offline systems. Errors are also always written to logs/backend/errors.jsonl.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0.0-1.0 share of requests/tasks traced for performance; keep 0.0 on high-traffic systems
SENTRY_TRACES_SAMPLE_RATE=0.0
# Name shown in GlitchTip; empty = container hostname
SENTRY_SERVER_NAME=

# Uplink network (scripts/setup_uplink_network.sh): DHCP first; this static
# address is used only when no DHCP server answers on UPLINK_INTERFACE.
UPLINK_INTERFACE=eth0
UPLINK_STATIC_IP=192.168.XX.XX
UPLINK_STATIC_NETMASK=255.255.240.0
UPLINK_STATIC_GATEWAY=192.168.0.1
# Optional, space separated (e.g. "192.168.0.1 8.8.8.8"); empty = no DNS server
UPLINK_STATIC_DNS=

# Network report (scripts/network_report.sh): known hosts of the site network
# the Pi should reach, space separated. Unset = built-in defaults, empty = skip.
#NET_REPORT_TARGETS="192.168.11.211 192.168.11.9 10.35.252.13"
#NET_REPORT_TARGET_GATEWAY="10.35.252.1"
#NET_REPORT_TARGET_DNS="10.174.0.8 10.174.0.40"
#NET_REPORT_TARGET_PORTS="22 80 443 445 3389 5432 8080"
