SKIP_PREFLIGHT_CHECK=true

PROTOCOL="https"
BACKEND_PORT=8383
FRONTEND_PORT=3003

FRONTEND_URL="@PROTOCOL://dashboard.progeo.com"
FULL_BACKEND_URL="@PROTOCOL://api.progeo.com"
BACKEND_URL="api.progeo.com"

LOGIN_TIME=3600

REDIS_PASSWORD="~~~~~~~~~~~~"
REDIS_HOST="progeo-redis"
REDIS_PORT=6379

DJANGO_DATABASES="main_db;unit_tests;dev_null"
POSTGRES_DB="default"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="progeo-database"
POSTGRES_PORT=5435

# Per-project databases (python manage.py split_project_dbs / add_project_db)
PROJECT_DB_SPLIT=False
PROJECT_DB_STRICT=False
PROJECT_DB_PREFIX=""
# Own database of the public demo (python manage.py demo_account)
DEMO_DATABASE="demo"

DNS_FRONT_NAMES="dashboard.progeo.com localhost"
DNS_BACK_NAMES="api.progeo.com"

CERT_MODE="existing"
CERT_LOCAL="./docker/nginx/ssl"
CERT_PATH="/etc/nginx/ssl"
CERT_FILE="localhost-bundle.pem"
CERT_KEY="localhost-bundle.pem"

CONTROLLER_SSID="Progeo-Controller"
CONTROLLER_PASSWORD="~~~~~~~~~~~~"
# Target of the frontend QR code (GET /v1/<account>/setup/controller/qrcodes/)
CONTROLLER_FRONTEND_URL="http://192.168.161.1:3003"
CONTROLLER_COUNTRY_CODE="DE"
CONTROLLER_DEFAULT_ACCOUNT="default"
CONTROLLER_PROJECT_ID=1312
CONTROLLER_ROOT_LOCATION_ID=1

DOCKER_GID="progeo"

# Optional helper service progeo-cad_factory (build + start):
#   COMPOSE_PROFILES=cad_factory  -> build and run the cad factory
#   COMPOSE_PROFILES=             -> skip it entirely (no build, no container)
COMPOSE_PROFILES=

# Error tracking (sentry-sdk -> GlitchTip, see progeo/sentry.py). Empty SENTRY_DSN = disabled,
# leave it empty on offline systems. Errors are also always written to logs/backend/errors.jsonl.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0.0-1.0 share of requests/tasks traced for performance; keep 0.0 on high-traffic systems
SENTRY_TRACES_SAMPLE_RATE=0.0
# Name shown in GlitchTip; empty = container hostname
SENTRY_SERVER_NAME=

# Uplink network (scripts/setup_uplink_network.sh): DHCP first; this static
# address is used only when no DHCP server answers on UPLINK_INTERFACE.
UPLINK_INTERFACE=eth0
UPLINK_STATIC_IP=192.168.XX.XX
UPLINK_STATIC_NETMASK=255.255.240.0
UPLINK_STATIC_GATEWAY=192.168.0.1
# Optional, space separated (e.g. "192.168.0.1 8.8.8.8"); empty = no DNS server
UPLINK_STATIC_DNS=

# Network report (scripts/network_report.sh): known hosts of the site network
# the Pi should reach, space separated. Unset = built-in defaults, empty = skip.
#NET_REPORT_TARGETS="192.168.11.211 192.168.11.9 10.35.252.13"
#NET_REPORT_TARGET_GATEWAY="10.35.252.1"
#NET_REPORT_TARGET_DNS="10.174.0.8 10.174.0.40"
#NET_REPORT_TARGET_PORTS="22 80 443 445 3389 5432 8080"
