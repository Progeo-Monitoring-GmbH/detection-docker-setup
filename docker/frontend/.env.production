SKIP_PREFLIGHT_CHECK=true

VITE_FRONTEND_PORT=3003
VITE_FRONTEND_URL="FRONTEND-TEMPLATE"
# Empty on purpose: the frontend calls the backend on its own origin and the
# serving nginx proxies /v1/, /api/, /ws/, ... to Django. So one build works
# under dashboard.progeo.com as well as http://192.168.161.1:3003.
VITE_BACKEND_URL=""
VITE_WS_URL=""
# Build-time flag of the server this frontend runs against. The Dockerfile
# replaces the placeholder with the VITE_SERVER_ENV build arg (default:
# production); "staging" turns on the pink staging frame + banner.
VITE_SERVER_ENV=SERVER_ENV-TEMPLATE
VITE_VERSION=$npm_package_version
