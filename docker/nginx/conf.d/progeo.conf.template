server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # DNS_BACK_NAMES without the names of the frontend block (fix_host_file.sh).
    server_name ${DNS_BACK_SERVER_NAMES};
    resolver 127.0.0.11 ipv6=off valid=30s;

    ssl_certificate ${CERT_PATH}/${CERT_FILE};
    ssl_certificate_key ${CERT_PATH}/${CERT_KEY};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # First, before the other locations: drops .env/.git/... scanner requests.
    include /etc/nginx/snippets/block_scanners.conf;

    # "Wartungsarbeiten" page while the backend is not reachable (still booting).
    include /etc/nginx/snippets/maintenance.conf;

    # Public flash bundles for the field app (https://api.progeo.com/firmware/).
    include /etc/nginx/snippets/firmware.conf;

    # Prometheus scrapes the backend directly (docker network); never public.
    location = /metrics {
        return 404;
    }

    location / {
        set $backend_upstream progeo-backend:8383;
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        set $backend_upstream progeo-backend:8383;
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
    }

    # Media files handed over by AuthenticatedMediaView (X-Accel-Redirect):
    # nginx serves them with zero-copy sendfile, so multi-GB backups do not
    # get streamed through Python. `internal` means only requests that carry
    # the X-Accel-Redirect header set by the authenticated Django view are
    # served here - direct external requests are refused, so authentication
    # stays enforced. The directory mirrors the ./media bind mount of the
    # backend container.
    #
    # The internal redirect drops the Django response's own headers, incl.
    # the CORS ones corsheaders set - without them the frontend (another
    # origin) can't read media via fetch/XHR. Re-add them from the original
    # response ($upstream_http_*; empty values are not sent). add_header in a
    # location disables inheriting the server's add_header lines, so those
    # are repeated here.
    location /protected-media/ {
        internal;
        alias /media/;

        add_header Access-Control-Allow-Origin $upstream_http_access_control_allow_origin always;
        add_header Access-Control-Allow-Credentials $upstream_http_access_control_allow_credentials always;
        add_header Vary $upstream_http_vary always;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "upgrade-insecure-requests" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}


server {
    listen 443 ssl;
    listen [::]:443 ssl;

    # DNS_FRONT_NAMES + localhost, each once (fix_host_file.sh).
    server_name ${DNS_FRONT_SERVER_NAMES};
    resolver 127.0.0.11 ipv6=off valid=30s;

    ssl_certificate ${CERT_PATH}/${CERT_FILE};
    ssl_certificate_key ${CERT_PATH}/${CERT_KEY};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # First, before the backend regex location below: drops scanner requests.
    include /etc/nginx/snippets/block_scanners.conf;

    # "Wartungsarbeiten" page while the frontend or backend is not reachable.
    include /etc/nginx/snippets/maintenance.conf;

    location / {
        set $frontend_upstream progeo-frontend:80;
        proxy_pass http://$frontend_upstream;
        add_header Content-Security-Policy "upgrade-insecure-requests" always;
        add_header X-Progeo-Route "dashboard-root" always;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Backend on the dashboard's own origin: the frontend is built without a
    # backend URL and calls these paths same-origin (no CORS, no extra DNS
    # name). The api server block above keeps working for other clients.
    location ~ ^/(v1|api|auth|media|static|aadmin)/ {
        set $backend_upstream progeo-backend:8383;
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        set $backend_upstream progeo-backend:8383;
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 1h;
        proxy_redirect off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Monitoring UIs (docker/monitoring/README.md), only for a Django superuser:
    # log in on /aadmin/ (or the portal) first. Without the monitoring profile
    # the containers don't resolve and these answer 502.
    location = /_monitoring_auth {
        internal;
        set $backend_upstream progeo-backend:8383;
        proxy_pass http://$backend_upstream/auth/monitoring/;
        # The subrequest has the client's method - a POST would hit Django's CSRF check.
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location @monitoring_login {
        return 302 /aadmin/login/?next=$request_uri;
    }

    # Grafana serves from /grafana/ itself (GF_SERVER_SERVE_FROM_SUB_PATH) and
    # logs the user in from X-WEBAUTH-USER - but only from this container's
    # address on monitoring_net (GF_AUTH_PROXY_WHITELIST = MONITORING_NGINX_IP).
    # proxy_set_header replaces a header of that name sent by the client.
    location /grafana/ {
        include /etc/nginx/snippets/monitoring_auth.conf;
        set $grafana_upstream progeo-grafana:3000;
        proxy_pass http://$grafana_upstream;
        proxy_set_header X-WEBAUTH-USER $monitoring_user;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana Live (dashboard updates over a WebSocket).
    location /grafana/api/live/ {
        include /etc/nginx/snippets/monitoring_auth.conf;
        set $grafana_upstream progeo-grafana:3000;
        proxy_pass http://$grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 1h;
        proxy_set_header X-WEBAUTH-USER $monitoring_user;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Prometheus has no login of its own. It serves from / (--web.route-prefix,
    # so Grafana and the scrape config keep their URLs) and builds its links
    # with /prometheus/ (--web.external-url) - the prefix is stripped here.
    location /prometheus/ {
        include /etc/nginx/snippets/monitoring_auth.conf;
        set $prometheus_upstream progeo-prometheus:9090;
        rewrite ^/prometheus(/.*)$ $1 break;
        proxy_pass http://$prometheus_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Flower serves from /flower/ itself (FLOWER_URL_PREFIX) and still asks
    # for its own basic auth (FLOWER_USER / FLOWER_PASSWORD).
    location /flower/ {
        include /etc/nginx/snippets/monitoring_auth.conf;
        set $flower_upstream progeo-flower:5555;
        proxy_pass http://$flower_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # See the api server block: X-Accel-Redirect target for large media.
    location /protected-media/ {
        internal;
        alias /media/;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /favicon.ico {
        set $frontend_upstream progeo-frontend:80;
        add_header Content-Security-Policy "upgrade-insecure-requests" always;
        add_header X-Progeo-Route "dashboard-favicon" always;
        proxy_pass http://$frontend_upstream/favicon.ico;
    }

    location /assets/ {
        #access_log off;
        set $frontend_upstream progeo-frontend:80;
        add_header Content-Security-Policy "upgrade-insecure-requests" always;
        add_header X-Progeo-Route "dashboard-assets" always;
        proxy_pass http://$frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}


# Matrix homeserver on MATRIX_DOMAIN (compose profile "messenger",
# docker/matrix/README.md). Only the client API is public; federation only
# with MATRIX_FEDERATION=1. Without the profile progeo-matrix doesn't
# resolve and the API answers 502.

# Matrix logins/registrations: 10 per minute and client address.
limit_req_zone $binary_remote_addr zone=matrix_login:10m rate=10r/m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${MATRIX_SERVER_NAME};
    resolver 127.0.0.11 ipv6=off valid=30s;

    ssl_certificate ${CERT_PATH}/${CERT_FILE};
    ssl_certificate_key ${CERT_PATH}/${CERT_KEY};

    # A JSON API: no page may embed or run anything from here.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Matches homeserver.yaml max_upload_size.
    client_max_body_size 10M;

    # 1 = federation endpoints are served (MATRIX_FEDERATION, fix_host_file.sh).
    set $matrix_federation ${MATRIX_FEDERATION_ENABLED};

    # The client API - all a client needs, media included (authenticated,
    # /_matrix/client/v1/media). ^~: the scanner regexes below never see it,
    # media file names may end in .log, .conf, ...
    location ^~ /_matrix/client/ {
        # Login, logout and token refresh belong to MAS (its compatibility
        # layer for clients without OAuth support).
        location ~ ^/_matrix/client/[^/]+/(login|logout|refresh)(/|$) {
            limit_req zone=matrix_login burst=5 nodelay;
            limit_req_status 429;
            include /etc/nginx/snippets/mas_proxy.conf;
        }
        location ~ ^/_matrix/client/[^/]+/register {
            limit_req zone=matrix_login burst=5 nodelay;
            limit_req_status 429;
            include /etc/nginx/snippets/matrix_proxy.conf;
        }
        include /etc/nginx/snippets/matrix_proxy.conf;
    }

    location ^~ /_matrix/federation/ {
        if ($matrix_federation != 1) {
            return 404;
        }
        include /etc/nginx/snippets/matrix_proxy.conf;
    }

    location ^~ /_matrix/key/ {
        if ($matrix_federation != 1) {
            return 404;
        }
        include /etc/nginx/snippets/matrix_proxy.conf;
    }

    # Other servers find the federation port here (federation only) ...
    location = /.well-known/matrix/server {
        if ($matrix_federation != 1) {
            return 404;
        }
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 '{"m.server": "${MATRIX_SERVER_NAME}:443"}';
    }

    # ... clients the homeserver.
    location = /.well-known/matrix/client {
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 '{"m.homeserver": {"base_url": "https://${MATRIX_SERVER_NAME}"}, "org.matrix.msc2965.authentication": {"issuer": "https://${MATRIX_AUTH_SERVER_NAME}/", "account": "https://${MATRIX_AUTH_SERVER_NAME}/account/"}}';
    }

    include /etc/nginx/snippets/block_scanners.conf;

    # Everything else stays closed: the admin API (/_synapse/admin), Synapse's
    # own pages (/_synapse/client: SSO, consent, email password reset - none
    # in use) and the unauthenticated legacy media API (/_matrix/media).
    # Admin work runs inside the container (docker/matrix/README.md).
    location / {
        return 404;
    }
}
# Matrix Authentication Service on MATRIX_AUTH_DOMAIN (compose profile
# "messenger"): the login pages and OAuth endpoints of the chat. Its only
# login is the ProGeo portal; MAS's admin API is not enabled at all.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${MATRIX_AUTH_SERVER_NAME};
    resolver 127.0.0.11 ipv6=off valid=30s;

    ssl_certificate ${CERT_PATH}/${CERT_FILE};
    ssl_certificate_key ${CERT_PATH}/${CERT_KEY};

    # MAS sets its own Content-Security-Policy for its pages.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 1M;

    include /etc/nginx/snippets/block_scanners.conf;

    location / {
        include /etc/nginx/snippets/mas_proxy.conf;
    }
}
