    {
      "type": "stat",
      "title": "Failed (24h)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum((sum by (task) (increase(flower_events_total{type=\"task-failed\"}[24h])) > 0 or (sum by (task) (flower_events_total{type=\"task-failed\"}) unless sum by (task) (flower_events_total{type=\"task-failed\"} offset 24h)))) or vector(0)",
