    {
      "type": "timeseries",
      "title": "Task events / min",
      "description": "received, started, succeeded, failed, retried ...",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(flower_events_total[$__rate_interval])) * 60",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
