    {
      "type": "timeseries",
      "title": "CPU by process group",
      "description": "Cores in use, stacked: together about the CPU of the container progeo-backend. From progeo-process-exporter (docker/monitoring/process-exporter/config.yml). api = uvicorn/daphne with its worker processes, celery worker = all worker processes, manage.py ... = one management command (cron jobs, docker exec), cron ... = the shell part of a cron job.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total[$__rate_interval])) > 0",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{groupname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
