        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Pressure: share of time processes had to wait",
      "description": "From the kernel (PSI). cpu = runnable processes waited for a core; memory = waited for memory to be freed; io = waited for the disk. Near 0 = the load fit; rising = the host was short of that resource.",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_pressure_cpu_waiting_seconds_total[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "cpu"
        },
        {
          "refId": "B",
          "expr": "rate(node_pressure_memory_waiting_seconds_total[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "memory"
        },
        {
          "refId": "C",
          "expr": "rate(node_pressure_io_waiting_seconds_total[$__rate_interval])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "io"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
