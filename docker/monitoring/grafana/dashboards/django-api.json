      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "4xx by view",
      "description": "401/403 spikes: expired tokens or scanners; 404 with view=unresolved: unknown URLs.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (view, status) (rate(progeo_http_requests_total{status=~\"4..\"}[$__rate_interval])) > 0",
          "legendFormat": "{{status}} {{view}}",
          "datasource": {
            "type": "prometheus",
