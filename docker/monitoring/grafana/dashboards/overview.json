    {
      "type": "row",
      "title": "Alerts and notifications",
      "collapsed": false,
      "id": 35,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "alertlist",
      "title": "Firing alerts (Alertmanager)",
      "description": "Current firing and pending alerts from progeo-alertmanager.",
      "id": 32,
      "datasource": {
        "type": "alertmanager",
        "uid": "alertmanager"
      },
      "options": {
        "alertName": "",
        "dashboardAlerts": false,
        "alertInstanceLabelFilter": "",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "inactive": false,
          "normal": false,
          "error": false
        },
        "showOptions": "current",
        "maxItems": 50,
        "sortOrder": 1,
        "viewMode": "list",
        "groupBy": [],
        "groupMode": "default"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Mail/SMS attempts (selected range)",
      "description": "Counts from progeo_outbound_messages_total; includes sent, failed, suppressed, blocked and test-mode attempts.",
      "id": 33,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, status) (increase(progeo_outbound_messages_total[$__range]))",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "channel": "Channel",
              "status": "Status",
              "Value": "Messages"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Time since last successful mail/SMS",
      "description": "Age of the last successful attempt per channel (progeo_outbound_last_attempt_timestamp_seconds).",
      "id": 34,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - progeo_outbound_last_attempt_timestamp_seconds{status=\"sent\"}",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "status": true
            },
            "renameByName": {
              "channel": "Channel",
              "Value": "Age"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 5
      }
