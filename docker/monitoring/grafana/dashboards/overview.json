    {
      "type": "timeseries",
      "title": "Requests by status class",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (label_replace(rate(progeo_http_requests_total[$__rate_interval]), \"class\", \"${1}xx\", \"status\", \"(.)..\"))",
