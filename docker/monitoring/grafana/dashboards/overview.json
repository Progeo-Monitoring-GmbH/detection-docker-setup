          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "F",
          "expr": "progeo_cron_job_running",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "job",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "job": "Name",
              "Value #A": "Status",
              "Value #B": "Last run age",
              "Value #C": "Last success age",
              "Value #D": "Last duration",
              "Value #E": "Every",
              "Value #F": "Running"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "index": 0,
                        "text": "OK",
                        "color": "green"
                      },
                      "-1": {
                        "index": 1,
                        "text": "running",
                        "color": "blue"
                      },
                      "1": {
                        "index": 2,
                        "text": "failed",
                        "color": "red"
                      }
                    }
                  }
