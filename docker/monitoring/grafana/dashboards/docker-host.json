      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (changes(container_start_time_seconds{name=~\"progeo-.+\"}[$__range])) > 0",
          "instant": true,
          "format": "table",
          "datasource": {
