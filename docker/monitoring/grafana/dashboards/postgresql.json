      "title": "Statements by mean time per call (selected range)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (datname, queryid) (increase(pg_stat_statements_seconds_total[$__range])) / (sum by (datname, queryid) (increase(pg_stat_statements_calls_total[$__range])) > 0)) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
