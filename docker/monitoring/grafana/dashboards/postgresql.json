    {
      "interval": "2m",
      "type": "timeseries",
      "title": "Buffer cache hit ratio",
      "description": "Below ~0.95 for long: shared_buffers (POSTGRES_SHARED_BUFFERS) too small for the working set.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_blks_hit[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit[$__rate_interval])) + sum(rate(pg_stat_database_blks_read[$__rate_interval])))",
