    {
      "type": "table",
      "title": "Statements by total time (selected range)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (datname, queryid) (increase(pg_stat_statements_seconds_total[$__range]))) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "total time",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "queryid": true
            },
            "renameByName": {
              "Value": "total time"
            }
          }
        }
      ],
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 10
      }
    },
    {
