# 1 only on a development machine: tracebacks, the debug toolbar and the
# LAN-wide CORS origins below are on with it.
DEBUG=0

# The names (and IPs) the server is reached under, comma separated. Added
# automatically: progeo-backend, localhost, 127.0.0.1 (prometheus, tools in the
# container) and LEGACY_GPRS_HOSTS. "*" accepts any Host header (check progeo.W010).
DJANGO_ALLOWED_HOSTS=api.progeo.local,dashboard.progeo.local
ALLOWED_ORIGINS="http://localhost,http://127.0.0.1,https://api.progeo.local,https://dashboard.progeo.local,http://api.progeo.local,http://dashboard.progeo.local"
# Credentialed requests from any localhost / 192.168.x.x origin (the Vite dev
# server). Default: on with DEBUG, off without.
#CORS_ALLOW_LOCAL_ORIGINS=0

SECRET_KEY="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
SIGNING_KEY="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
VERIFYING_KEY="~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"

DJANGO_SUPERUSER_USERNAME=progeo
DJANGO_SUPERUSER_PASSWORD=~~~~~~~~
DJANGO_SUPERUSER_EMAIL="kontakt@progeo.com"

BACKUP_DIR=backup
SETUP_DIR=setup
UPLOAD_DIR=uploads
EXPORT_DIR=exports

MAIL_SENDER="Mess-Server <kontakt@progeo.com>"
MAIL_REPLY_TO="kontakt@progeo.com"
MAIL_SERVER="smtp.progeo.com"
MAIL_PORT=587
MAIL_USER="no-reply@progeo.com"
MAIL_PW="~~~~~~~~"

# ---------------------------------------------------------------------------
# Outbound mail / SMS safety (progeo/helper/outbound.py)
# ---------------------------------------------------------------------------
# Notifications (alarm / offline) only go out for locations whose
# notifications staff switched on (device statistics page) - new and existing
# locations start switched off. While SMS_DRY_RUN / MESSENGER_DRY_RUN is not
# 0, SMS / messenger messages (Signal, WhatsApp, Matrix) are only logged.
# Production sets them to 0 explicitly.
SMS_DRY_RUN=1
MESSENGER_DRY_RUN=1
# Return-Path - bounces arrive in this mailbox. Empty = MAIL_USER.
MAIL_ENVELOPE_FROM=
# Hard limits - we never mass send. Hitting a GLOBAL limit trips the circuit
# breaker: all mail AND SMS stop until staff reset it (Benutzerverwaltung ->
# Versand). Empty = the defaults shown.
#MAIL_MAX_RECIPIENTS=5
#MAIL_LIMIT_PER_RECIPIENT_HOUR=20
#MAIL_LIMIT_PER_RECIPIENT_DAY=100
#MAIL_LIMIT_GLOBAL_HOUR=100
#SMS_LIMIT_PER_RECIPIENT_HOUR=3
#SMS_LIMIT_PER_RECIPIENT_DAY=10
#SMS_LIMIT_GLOBAL_HOUR=20
#SMS_LIMIT_GLOBAL_DAY=50
# SMS are cut to this many segments (160 GSM-7 / 70 Unicode characters each)
#SMS_MAX_SEGMENTS=1
# Signal / WhatsApp / Matrix together
#MESSENGER_LIMIT_PER_RECIPIENT_HOUR=10
#MESSENGER_LIMIT_PER_RECIPIENT_DAY=50
#MESSENGER_LIMIT_GLOBAL_HOUR=50
#MESSENGER_LIMIT_GLOBAL_DAY=200
# Request-triggered mails go through celery (0 = send inline)
#OUTBOUND_ASYNC=1
# Alarms older than MAX_AGE (re-evaluated history) notify nobody
#ALARM_NOTIFY_MAX_AGE_HOURS=6
# Staged notifications (docs/notifications.md): offline mails only between
# START and END hour (Europe/Berlin), alarms at any time
#NOTIFY_WINDOW_START_HOUR=9
#NOTIFY_WINDOW_END_HOUR=22
# Device offline after max(2 send intervals, this many hours) without data
#NOTIFY_OFFLINE_AFTER_HOURS=6
# Devices silent longer than this when first seen offline open no case
#NOTIFY_OFFLINE_IGNORE_AFTER_DAYS=60
# Offline stages (days after detection): notice, reminder, + Objektleitung, escalation
#NOTIFY_OFFLINE_STAGE_DAYS=0,3,7,14
# Alarm stages (hours after the alarm, until acknowledged): notice, reminder, escalation
#NOTIFY_ALARM_STAGE_HOURS=0,4,24
# Device must be back this long before "wieder online"
#NOTIFY_ONLINE_STABLE_HOURS=2
# Offline again within this window: case reopens at its stage (no new first notice)
#NOTIFY_REOPEN_HOURS=48
# At most one "wieder online" mail per location within this many days
#NOTIFY_ONLINE_MAIL_COOLDOWN_DAYS=7
# Share of MAIL_LIMIT_GLOBAL_HOUR the offline mails may use per hour
#NOTIFY_OFFLINE_MAIL_SHARE=0.5
# Validity of the acknowledge/unsubscribe links in the mails
#NOTIFY_LINK_DAYS=60
# Daily staff digest (escalations, unreachable cases, unsubscribes)
#NOTIFY_STAFF_ADDRESS=kontakt@progeo.com
# One-time links
#MAGIC_LINK_LOGIN_MINUTES=15
#MAGIC_LINK_INVITE_HOURS=72
# Invitations by email from the Rechte tab, per inviting user and hour
#ACCESS_INVITES_PER_HOUR=20
# Look the position up again when a location's address is saved (Nominatim)
#GEOCODE_ON_SAVE=true
# One-time migration campaign (manage.py migration_invites): 1 only while the
# info mails go out - set back to 0 afterwards. Links stay valid for the days.
#MIGRATION_INVITES_ENABLED=0
#MIGRATION_INVITE_DAYS=21
#MIGRATION_INVITES_PER_HOUR=40
#ACCESS_REQUEST_VERIFY_HOURS=48
# 1 = staff/superusers may log in per mailed link too (not recommended)
#MAGIC_LINK_ALLOW_STAFF=0
# Password reset link (only users with 2FA can reset their password themselves)
#PASSWORD_RESET_MINUTES=30
# Failed logins (password or 2FA code) before a name / IP is locked for 15 min
#LOGIN_MAX_FAILURES_PER_NAME=10
#LOGIN_MAX_FAILURES_PER_IP=50
# Before that per name: free failures, then a wait since the last failure of
# BASE seconds, doubling per further failure up to MAX (2, 4, 8, ... 300)
#LOGIN_BACKOFF_FREE_FAILURES=3
#LOGIN_BACKOFF_BASE_SECONDS=2
#LOGIN_BACKOFF_MAX_SECONDS=300
# Days a DRF token of /auth/login/ is valid (0 = forever)
#DRF_TOKEN_MAX_AGE_DAYS=30
# Days a JWT refresh token of /api/token/ is valid (rotated on every refresh) -
# how long the mobile app stays logged in without being opened
#JWT_REFRESH_TOKEN_DAYS=1
# 2FA: name shown in authenticator apps; 1 = staff must set up 2FA first
#TWO_FACTOR_ISSUER=ProGeo
#TWO_FACTOR_REQUIRED_FOR_STAFF=0
# Key for the stored 2FA secrets (empty = from SECRET_KEY). Set once, never change -
# changing it (or SECRET_KEY without it) invalidates every 2FA device.
#TWO_FACTOR_ENCRYPTION_KEY=
# Who is told about new access requests; empty = DJANGO_SUPERUSER_EMAIL
ACCESS_REQUEST_NOTIFY=
# Bounce mailbox (IMAP, read every 10 min). User/password default to
# MAIL_USER/MAIL_PW - the mailbox of the envelope sender. Empty host = off.
BOUNCE_IMAP_HOST="imap.strato.de"
BOUNCE_IMAP_PORT=993
#BOUNCE_IMAP_USER=
#BOUNCE_IMAP_PASSWORD=
#BOUNCE_IMAP_FOLDER=INBOX
#BOUNCE_IMAP_PROCESSED_FOLDER=progeo-bounces

#SECURE_HSTS_PRELOAD=true
#SECURE_HSTS_SECONDS=1800
#SECURE_SSL_REDIRECT=true
##SECURE_REDIRECT_EXEMPT=false
##SECURE_PROXY_SSL_HEADER=false
#SECURE_REFERRER_POLICY="strict-origin-when-cross-origin"

# Secure-only cookies: on by default with PROTOCOL=https. Set both to 0 only
# for a setup served over plain http (e.g. a local dev server).
#CSRF_COOKIE_SECURE=1
#SESSION_COOKIE_SECURE=1

TIME_CALC_OFFSET=-3600



# Esendex SMS gateway (progeo/helper/esendex.py, "Schnittstelle" -> SMS panel)
ESENDEX_ACCOUNT_REFERENCE=
ESENDEX_USERNAME=
ESENDEX_PASSWORD=
ESENDEX_FROM=

# Messenger gateways (progeo/helper/messenger.py, "Schnittstelle" -> Messenger
# panels). Used until a config is saved there; empty = service not offered.
# Signal goes through Matrix: the Signal bridge (compose profile "messenger";
# its secret is MATRIX_SIGNAL_PROVISIONING_SECRET of .env) sends for the Matrix
# bot. Link ProGeo's Signal number under Schnittstelle -> Signal.
#SIGNAL_BRIDGE_URL=http://progeo-signal-bridge:29328
# WhatsApp Business Cloud API (Meta). Outside the 24h customer service window
# only approved templates are delivered: set WHATSAPP_TEMPLATE to a template
# with one body parameter {{1}} - the notification text.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=de
# Matrix: homeserver + access token of the bot that DMs the users. Own
# homeserver (compose profile "messenger") by default; the token comes from
# `mas-cli manage issue-compatibility-token progeo-bot` (docker/matrix/README.md).
#MATRIX_HOMESERVER=http://progeo-matrix:8008
MATRIX_ACCESS_TOKEN=
MODBUS_TCP_HOST=127.0.0.1
MODBUS_TCP_PORT=502
MODBUS_TCP_UNIT_ID=1
MODBUS_TCP_TIMEOUT=3
MODBUS_TCP_START_ADDRESS=0

# ---------------------------------------------------------------------------
# Server role / feature flags
# ---------------------------------------------------------------------------
# 1/0: this server is configured as a root server
PROGEO_CONFIG_IS_ROOT_SERVER=0

# IP/hostname of the root server this node reports to; empty when unset
PROGEO_CONFIG_HAS_ROOT_SERVER=192.168.161.1

# 1/0: this server is configured as a node server
PROGEO_CONFIG_IS_NODE_SERVER=1

# 1/0: whether mails should be sent (daily reports, disconnect notifications, ...)
PROGEO_CONFIG_ENABLE_MAILING=0

# 1/0: whether celery should take measurements 
PROGEO_CONFIG_ENABLE_MEASUREMENTS=0

# 1/0: evaluate every measurement for alarms right when it is stored instead of
#      the hourly celery task (recommended for low-traffic servers)
PROGEO_CONFIG_EVALUATE_INSTANTLY=0

# ---------------------------------------------------------------------------
# Airtable (pyairtable) integration
# ---------------------------------------------------------------------------
# Personal access token / API key (placeholder - set a real token)
AIRTABLE_API_KEY="~~~~~~~~"
# Base id of the progeo Airtable base
AIRTABLE_BASE_ID="~~~~~~~~"
# Name or id of the projects table inside the base
AIRTABLE_PROJECTS_TABLE=Projects
# Text field of the projects table that `manage.py lageplan_resolution
# --airtable` writes the grade of a low-res Lageplan into (create it by hand)
AIRTABLE_LAGEPLAN_RESOLUTION_FIELD="Lageplan Auflösung"

# Detect the heat limitations (building outlines) of a Lageplan automatically
# after an upload, a CAD import, a placement or an alignment (celery task;
# hand-made areas are never replaced). 0 switches it off.
AUTO_HEAT_LIMITATIONS=1
# Name or id of the documents table (the project's files; the wizard offers
# the "MEA-Dokumente" ones - helper/airtable_documents.py)
AIRTABLE_DOCUMENTS_TABLE=Dokumente
# manuSensor app: the factory's dm sensor table, the table the site
# measurements are copied to (create it in the base), and the tolerance (%)
# of |R_Baustelle - R_Werk| that counts as "ok".
AIRTABLE_DM_SENSORS_TABLE="dm Sensoren"
# The dm production orders - the projects /staff/sensors/ imports "dm Sensoren" from.
AIRTABLE_DM_ORDERS_TABLE="PA: dm"
AIRTABLE_SITE_MEASUREMENTS_TABLE=Baustellenmessungen
MANUSENSOR_TOLERANCE_PERCENT=5

# ---------------------------------------------------------------------------
# Device provisioning (/device/provision/)
# ---------------------------------------------------------------------------
# Origin the provisioned controllers send their samples to
# (<origin>/v1/device/<project_id>/sample/). Empty = https://api.progeo.com;
# on a local dev system e.g. http://192.168.0.42:8383
DEVICE_SAMPLE_BASE_URL=

# ---------------------------------------------------------------------------
# Flash bundle uploads (/v1/firmware/, STRATEGY.md section 4)
# ---------------------------------------------------------------------------
# Bearer token release.sh / promote.sh upload with; empty = upload API off (404).
# nginx serves the stored files publicly at /firmware/. Generate: openssl rand -hex 32
FIRMWARE_UPLOAD_TOKEN=
