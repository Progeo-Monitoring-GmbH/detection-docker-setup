# ---------------------------------------------------------------------------
# Server role / feature flags
# ---------------------------------------------------------------------------
# 1/0: this server is configured as a root server
PROGEO_CONFIG_IS_ROOT_SERVER=0

# IP/hostname of the root server this node reports to; empty when unset
PROGEO_CONFIG_HAS_ROOT_SERVER=192.168.161.1

# 1/0: this server is configured as a node server
PROGEO_CONFIG_IS_NODE_SERVER=1

# 1/0: whether mails should be sent (daily reports, disconnect notifications, ...)
PROGEO_CONFIG_ENABLE_MAILING=0

# 1/0: whether celery should take measurements 
PROGEO_CONFIG_ENABLE_MEASUREMENTS=0

