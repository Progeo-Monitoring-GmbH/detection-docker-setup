# ---------------------------------------------------------------------------
# Outbound mail / SMS safety (progeo/helper/outbound.py)
# ---------------------------------------------------------------------------
# SAFE BY DEFAULT: while MAIL_TEST_MODE is not 0, EVERY mail goes to
# MAIL_TEST_RECIPIENT (original recipients in the subject); while SMS_DRY_RUN
# is not 0, SMS are only logged. Production sets both to 0 explicitly.
MAIL_TEST_MODE=1
MAIL_TEST_RECIPIENT="test-mails@progeo.com"
SMS_DRY_RUN=1
# Return-Path - bounces arrive in this mailbox. Empty = MAIL_USER.
MAIL_ENVELOPE_FROM=
# Hard limits - we never mass send. Hitting a GLOBAL limit trips the circuit
# breaker: all mail AND SMS stop until staff reset it (Benutzerverwaltung ->
# Versand). Empty = the defaults shown.
#MAIL_MAX_RECIPIENTS=5
#MAIL_LIMIT_PER_RECIPIENT_HOUR=20
#MAIL_LIMIT_PER_RECIPIENT_DAY=100
#MAIL_LIMIT_GLOBAL_HOUR=100
#SMS_LIMIT_PER_RECIPIENT_HOUR=3
#SMS_LIMIT_PER_RECIPIENT_DAY=10
#SMS_LIMIT_GLOBAL_HOUR=20
#SMS_LIMIT_GLOBAL_DAY=50
# SMS are cut to this many segments (160 GSM-7 / 70 Unicode characters each)
#SMS_MAX_SEGMENTS=1
# Request-triggered mails go through celery (0 = send inline)
#OUTBOUND_ASYNC=1
# One alarm notification per location within the cooldown; alarms older than
# MAX_AGE (re-evaluated history) notify nobody
#ALARM_NOTIFY_COOLDOWN_MINUTES=60
#ALARM_NOTIFY_MAX_AGE_HOURS=6
# One-time links
#MAGIC_LINK_LOGIN_MINUTES=15
#MAGIC_LINK_INVITE_HOURS=72
#ACCESS_REQUEST_VERIFY_HOURS=48
# 1 = staff/superusers may log in per mailed link too (not recommended)
#MAGIC_LINK_ALLOW_STAFF=0
# Password reset link (only users with 2FA can reset their password themselves)
#PASSWORD_RESET_MINUTES=30
# Failed logins (password or 2FA code) before a name / IP is locked for 15 min
#LOGIN_MAX_FAILURES_PER_NAME=10
#LOGIN_MAX_FAILURES_PER_IP=50
# Days a DRF token of /auth/login/ is valid (0 = forever)
#DRF_TOKEN_MAX_AGE_DAYS=30
# 2FA: name shown in authenticator apps; 1 = staff must set up 2FA first
#TWO_FACTOR_ISSUER=ProGeo
#TWO_FACTOR_REQUIRED_FOR_STAFF=0
# Key for the stored 2FA secrets (empty = from SECRET_KEY). Set once, never change -
# changing it (or SECRET_KEY without it) invalidates every 2FA device.
#TWO_FACTOR_ENCRYPTION_KEY=
# Who is told about new access requests; empty = DJANGO_SUPERUSER_EMAIL
ACCESS_REQUEST_NOTIFY=
# Bounce mailbox (IMAP, read every 10 min). User/password default to
# MAIL_USER/MAIL_PW - the mailbox of the envelope sender. Empty host = off.
BOUNCE_IMAP_HOST="imap.strato.de"
BOUNCE_IMAP_PORT=993
#BOUNCE_IMAP_USER=
#BOUNCE_IMAP_PASSWORD=
#BOUNCE_IMAP_FOLDER=INBOX
#BOUNCE_IMAP_PROCESSED_FOLDER=progeo-bounces

