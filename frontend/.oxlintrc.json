{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import"],
  "categories": {
    "correctness": "error"
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-empty-function": "off",
    "curly": ["error", "all"]
  },
  "ignorePatterns": ["node_modules/", "dist/", "bin/", ".storybook/"]
}
