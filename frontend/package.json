{
  "name": "progeo",
  "version": "0.0.1",
  "homepage": "https://dashboard.progeo.app",
  "scripts": {
    "start": "vite --mode development",
    "dev": "vite --host",
    "pre-build": "echo 'Running TypeScript build' && tsc",
    "build": "echo 'Running Vite build' && vite build --debug",
    "serve": "vite preview --port 3003 --host",
    "test": "vitest",
    "lint": "oxlint src",
    "lint-fix": "oxlint --fix src && prettier --write src",
    "test:coverage": "vitest run --coverage --watch=false",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --check src"
  },
  "type": "module",
  "sideEffects": false,
  "__UPDATING-COMMAND_INST__": "npm install -g npm-check-updates",
  "__UPDATING-COMMAND_RUN__": "ncu --interactive --format group",
  "__RUN_DEEPSEEK__": "npx @deepseek-ai/dsh web",
  "devDependencies": {
    "@storybook/addon-links": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.2",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.2",
    "sass": "^1.108.1",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@types/plotly.js": "^3.0.15",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "buffer": "^6.0.3",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.10",
    "js-cookie": "^3.0.8",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "luxon": "^3.7.2",
    "notistack": "^3.0.2",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-bootstrap-typeahead": "^6.4.2",
    "react-data-table-component": "^8.12.0",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-leaflet": "^5.0.0",
    "react-plotly.js": "^4.1.0",
    "react-router": "^8.5.1",
    "react-spinners": "^0.17.1",
    "react-use-websocket": "^4.13.0",
    "styled-components": "^6.6.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
