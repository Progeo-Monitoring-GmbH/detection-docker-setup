    "react-data-table-component": "^8.8.1",
    "react-datepicker": "^9.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
