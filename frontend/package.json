{
  "name": "progeo",
  "version": "0.0.1",
  "homepage": "https://dashboard.progeo.app",
  "scripts": {
    "start": "vite --mode development",
    "dev": "vite --host 192.168.0.107",
    "pre-build": "echo 'Running TypeScript build' && tsc",
    "build": "echo 'Running Vite build' && vite build --debug",
    "serve": "vite preview --port 3003 --host",
    "test": "vitest",
    "lint": "eslint src/**/*.{ts,tsx,js,jsx}",
    "lint-fix": "eslint --quiet --fix src/**/*.{ts,tsx,js,jsx}",
    "test:coverage": "vitest run --coverage --watch=false"
  },
  "type": "module",
  "sideEffects": false,
  "__UPDATING-COMMAND_INST__": "npm install -g npm-check-updates",
  "__UPDATING-COMMAND_RUN__": "ncu --interactive --format group",
  "__RUN_DEEPSEEK__": "npx @deepseek-ai/dsh web",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.103.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-entry-shaking": "^0.5.2",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-obfuscator": "^1.0.5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@mui/material": "^9.3.1",
    "@types/plotly.js": "^3.0.13",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootswatch": "^5.3.8",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "js-cookie": "^3.0.8",
